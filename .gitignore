# Dependencies
node_modules
.pnpm-store

# Production build
dist
dist-ssr
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvsca
*.njsproj
*.sln
*.sw?

# Dataset maestro generado por prepare_data.py.
# La app consume public/data/*.json (que sí se versiona), por eso el
# archivo monolítico de 18 MB no se sube al repositorio.
data.json
*.bak

# Archivos de trabajo que no forman parte de la app
*.wav
descarga.png
Antecedentes*.pdf

# Cache del rastreo de empleados: los PDF oficiales descargados (~540 MB) y el
# texto extraido se pueden regenerar con rastreo_documentos_lote.py.
# Lo que SI se versiona es rastreo/urls_*.json, rastreo/lote_*.json y
# empleados_anclas.json, que son el resultado con sus fuentes.
rastreo/cache/
rastreo/texto/

# Python
__pycache__/
*.pyc
